#!/usr/bin/env bash
# Make Pi's update commands work when the Pi executable is managed by mise.
# Without mise, run the next pi on PATH (for example an npm global install).
set -euo pipefail

resolve_path() {
  local source="$1"
  local dir
  while [[ -L "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$source")"
}

fallback_pi() {
  local self dir candidate resolved
  self="$(resolve_path "$0")"
  local IFS=':'
  for dir in $PATH; do
    [[ -n "$dir" ]] || dir="."
    candidate="$dir/pi"
    [[ -x "$candidate" && ! -d "$candidate" ]] || continue
    resolved="$(resolve_path "$candidate")"
    [[ "$resolved" == "$self" ]] && continue
    printf '%s\n' "$resolved"
    return 0
  done
  return 1
}

if ! command -v mise >/dev/null 2>&1; then
  pi_bin="$(fallback_pi)" || {
    echo "pi: mise is not installed, and no other pi executable is on PATH." >&2
    exit 127
  }
  exec "$pi_bin" "$@"
fi

update_pi() {
  if [[ "${1:-}" == "--force" ]]; then
    MISE_MINIMUM_RELEASE_AGE=0 mise install --force pi@latest
  else
    MISE_MINIMUM_RELEASE_AGE=0 mise upgrade pi
  fi
}

case "${1:-}" in
  update)
    case "${2:-}" in
      ""|pi|self|--self)
        update_pi "${3:-}"
        exit
        ;;
      --all)
        update_pi
        pi_bin="$(mise which pi)"
        exec "$pi_bin" update --extensions "${@:3}"
        ;;
    esac
    ;;
esac

pi_bin="$(mise which pi)"
exec "$pi_bin" "$@"
